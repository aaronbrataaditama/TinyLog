#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_IDLE      ICON "idle.ico"
IDI_RECORDING ICON "recording.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TINYLOG_VERSION_RC
 PRODUCTVERSION TINYLOG_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "TinyLog work logger"
      VALUE "FileVersion", TINYLOG_VERSION_RC_STR
      VALUE "InternalName", "TinyLog"
      VALUE "OriginalFilename", "TinyLog.exe"
      VALUE "ProductName", "TinyLog"
      VALUE "ProductVersion", TINYLOG_VERSION_RC_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
